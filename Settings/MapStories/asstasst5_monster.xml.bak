                <OKResult>me:TriggerStory("xaou1000");</OKResult>
            </li>
            <li>
                <Display></Display>
            </li>
                
</Selections></Story>

    <Story Name="xaou1000" Parent="BaseFillingStory">
        <DisplayName>ปลดล็อควิชาบ่มเพาะ (ระดับสวรรค์)</DisplayName>
